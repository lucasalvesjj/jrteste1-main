# ──────────────────────────────────────────────
# Cloudflare Pages — Security + Cache Headers
# ──────────────────────────────────────────────

# ── Security + Default Cache (todas as respostas) ─
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://static.hotjar.com https://script.hotjar.com https://connect.facebook.net https://cdn.popt.in https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://stats.g.doubleclick.net https://*.hotjar.com https://*.hotjar.io https://connect.facebook.net https://cloudflareinsights.com; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'
  Cache-Control: no-cache, no-store, must-revalidate

# ── Cache: Assets Vite (hash no nome = imutavel) ─
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable
/assets/*.css
  Cache-Control: public, max-age=31536000, immutable
/assets/*.webp
  Cache-Control: public, max-age=31536000, immutable
/assets/*.png
  Cache-Control: public, max-age=31536000, immutable
/assets/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/assets/*.svg
  Cache-Control: public, max-age=31536000, immutable

# ── Cache: Media (UUID no path = imutavel) ────
/media/*
  Cache-Control: public, max-age=31536000, immutable

# ── Cache: Imagens do site ────────────────────
/images/*
  Cache-Control: public, max-age=31536000, immutable

# ── Cache: Favicons ───────────────────────────
/favicon.ico
  Cache-Control: public, max-age=86400

# ── Cache: JSON dinamico ─────────────────────
/data/*.json
  Cache-Control: public, max-age=60, stale-while-revalidate=300

# ── Cache: Tracking codes (mais fresco) ──────
/data/tracking-codes.json
  Cache-Control: public, max-age=30, stale-while-revalidate=60

# ── Cache: Sitemaps + robots ─────────────────
/sitemap-*.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600

# ── Cache: Version (sempre fresco) ───────────
/version.json
  Cache-Control: no-cache
